<view class="page login-page">
  <view class="hero">
    <text class="title">桌游搭子</text>
    <text class="subtitle">找剧本杀、狼人杀、血染钟楼、跑团和桌游局</text>
  </view>

  <view class="card">
    <button class="btn btn-primary btn-full wechat-btn" loading="{{wechatSubmitting}}" bindtap="wechatLogin">微信登录</button>

    <view class="divider"></view>

    <view class="mode-tabs">
      <button class="mode-tab {{mode === 'login' ? 'mode-active' : ''}}" bindtap="switchLogin">登录</button>
      <button class="mode-tab {{mode === 'register' ? 'mode-active' : ''}}" bindtap="switchRegister">注册</button>
    </view>

    <view wx:if="{{mode === 'register'}}" class="field">
      <text class="label">昵称</text>
      <input class="input" value="{{form.nickname}}" data-field="nickname" bindinput="onInput" maxlength="20" placeholder="怎么称呼你" />
    </view>

    <view class="field">
      <text class="label">手机号或微信号</text>
      <input class="input" value="{{form.identifier}}" data-field="identifier" bindinput="onInput" placeholder="用于登录和通过后联系" />
    </view>

    <view class="field">
      <text class="label">密码</text>
      <input class="input" value="{{form.password}}" data-field="password" bindinput="onInput" password placeholder="至少 6 位" />
    </view>

    <button class="btn btn-primary btn-full submit" loading="{{submitting}}" bindtap="submit">
      {{mode === 'login' ? '登录' : '注册并进入'}}
    </button>
  </view>
</view>
