<view class="page">
  <view class="toolbar">
    <view><text class="title">我的匹配</text><text class="subtitle">互相喜欢后，再决定是否联系</text></view>
    <button wx:if="{{loggedIn}}" class="btn btn-secondary btn-small" bindtap="load">刷新</button>
  </view>
  <view wx:if="{{!loggedIn}}" class="card login-card"><text class="section-title">登录后查看匹配</text><button class="btn btn-primary btn-full login-btn" bindtap="goLogin">登录</button></view>
  <view wx:elif="{{loading}}" class="loading">加载中...</view>
  <view wx:elif="{{!list.length}}" class="empty">还没有匹配，去发现页看看同好吧</view>
  <view wx:else class="list">
    <view wx:for="{{list}}" wx:key="id" class="card match-card">
      <view class="person-head"><view class="avatar">{{item.initial}}</view><view class="person-main"><text class="person-name">{{item.nickname}}</text><text class="person-meta">{{item.city || '城市未填写'}}</text><text wx:if="{{item.reliability && item.reliability.total}}" class="person-meta">可靠度 {{item.reliability.score}}%</text></view></view>
      <text wx:if="{{item.intro}}" class="person-intro">{{item.intro}}</text>
      <text wx:if="{{item.wechat}}" class="wechat">微信号：{{item.wechat}}</text>
      <view class="action-row"><button class="btn btn-secondary btn-small" data-id="{{item.id}}" bindtap="report">举报</button><button class="btn btn-danger btn-small" data-id="{{item.id}}" bindtap="block">拉黑</button></view>
    </view>
  </view>
</view>
