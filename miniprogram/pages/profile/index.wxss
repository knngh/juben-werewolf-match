.login-card {
  margin-top: 36rpx;
}

.login-btn {
  margin-top: 24rpx;
}

.completion-card {
  margin-top: 28rpx;
}
.quick-nav { display: grid; grid-template-columns: repeat(2, 1fr); gap: 10rpx; margin-top: 24rpx; }
.quick-nav-item { min-height: 108rpx; padding: 16rpx 8rpx; border: 1rpx solid #dfe7dc; border-radius: 12rpx; background: #ffffff; text-align: left; }
.quick-nav-title { display: block; color: #2f3a2f; font-size: 25rpx; font-weight: 700; }
.quick-nav-hint { display: block; margin-top: 8rpx; color: #7b8075; font-size: 20rpx; line-height: 1.35; }

.completion-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #2c332d;
  font-size: 28rpx;
  font-weight: 700;
}

.completion-head text:last-child {
  color: #1f7a4d;
}

.progress {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e1e7dc;
}

.progress view {
  height: 100%;
  border-radius: 999rpx;
  background: #1f7a4d;
}

.profile-card {
  position: relative;
  padding-top: 26rpx;
}

.notify-head,
.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.switch-row {
  min-height: 78rpx;
  border-top: 1rpx solid #e7ebe2;
  color: #334033;
  font-size: 27rpx;
}

.switch-row:first-of-type {
  border-top: 0;
}

.starter-btn {
  align-self: flex-end;
}

.save-btn {
  margin-top: 28rpx;
}

.logout-btn {
  margin-top: 24rpx;
}
