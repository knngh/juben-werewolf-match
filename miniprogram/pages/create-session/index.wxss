.form-card {
  padding-top: 8rpx;
}

.ai-panel {
  padding: 20rpx;
  border: 1rpx solid #cfe0d5;
  border-radius: 14rpx;
  background: #f6fbf7;
}

.ai-textarea {
  min-height: 120rpx;
}

.ai-btn {
  margin-top: 14rpx;
}

.location-row {
  display: grid;
  grid-template-columns: 1fr 132rpx;
  gap: 12rpx;
  align-items: stretch;
}

.location-btn {
  height: 80rpx;
  padding: 0;
}

.place-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.place-item {
  padding: 18rpx;
  border: 1rpx solid #dbe2d5;
  border-radius: 12rpx;
  background: #fbfcf8;
}

.place-name {
  display: block;
  color: #20231f;
  font-size: 27rpx;
  font-weight: 700;
}

.place-meta {
  display: block;
  margin-top: 6rpx;
  color: #697166;
  font-size: 24rpx;
  line-height: 1.5;
}

.submit {
  margin-top: 28rpx;
}
