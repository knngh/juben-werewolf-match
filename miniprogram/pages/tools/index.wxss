.tools-page {
  padding-top: 22rpx;
  padding-bottom: 60rpx;
}

.tool-header {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #25352a;
  color: #ffffff;
}

.eyebrow {
  display: block;
  color: #b4d8bf;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.tool-title {
  display: block;
  margin-top: 10rpx;
  font-size: 37rpx;
  font-weight: 800;
  line-height: 1.3;
}

.tool-meta {
  display: block;
  margin-top: 8rpx;
  color: #c6d4c9;
  font-size: 23rpx;
}

.switch-script {
  min-height: 56rpx;
  padding: 0 16rpx;
  border: 1rpx solid rgba(220, 240, 224, 0.42);
  border-radius: 8rpx;
  color: #e1f1e4;
  font-size: 23rpx;
}

.tool-tabs {
  display: flex;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 6rpx;
  border-radius: 10rpx;
  background: #e8eee7;
}

.tool-tab {
  flex: 1;
  min-height: 66rpx;
  border-radius: 8rpx;
  color: #69766b;
  font-size: 24rpx;
}

.tool-tab-active {
  background: #ffffff;
  color: #1f7a4d;
  font-weight: 700;
}

.tool-panel {
  margin-top: 22rpx;
}

.timer-card {
  padding: 30rpx 24rpx 24rpx;
  border: 1rpx solid #dce6dd;
  border-radius: 12rpx;
  background: #f7fbf7;
  text-align: center;
}

.timer-caption,
.section-head,
.note-item-head,
.recent-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.timer-caption {
  color: #6e7a70;
  font-size: 24rpx;
}

.timer-caption text:last-child {
  color: #1f7a4d;
  font-weight: 700;
}

.timer-text {
  display: block;
  margin-top: 20rpx;
  color: #1c3022;
  font-size: 92rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
  line-height: 1;
}

.timer-hint,
.section-hint {
  color: #7c877d;
  font-size: 22rpx;
}

.timer-hint {
  display: block;
  margin-top: 12rpx;
}

.timer-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 26rpx;
}

.timer-main {
  flex: 1;
}

.timer-reset {
  flex: 0 0 150rpx;
}

.tool-section {
  margin-top: 28rpx;
}

.first-section {
  margin-top: 0;
}

.section-head .section-title,
.section-title {
  margin-bottom: 0;
  color: #27372b;
  font-size: 30rpx;
}

.segment-list {
  margin-top: 16rpx;
  overflow: hidden;
  border: 1rpx solid #e0e5de;
  border-radius: 10rpx;
  background: #ffffff;
}

.segment-row {
  display: flex;
  min-height: 78rpx;
  gap: 14rpx;
  align-items: center;
  padding: 0 18rpx;
  border-bottom: 1rpx solid #edf0eb;
  color: #526055;
  font-size: 25rpx;
}

.segment-row:last-child {
  border-bottom: 0;
}

.segment-active {
  background: #eff7f0;
  color: #1f7a4d;
  font-weight: 700;
}

.segment-state {
  display: flex;
  flex: 1;
  gap: 12rpx;
  align-items: center;
}

.segment-index {
  display: inline-flex;
  width: 36rpx;
  height: 36rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #edf2eb;
  color: #5f6c61;
  font-size: 21rpx;
}

.segment-minutes {
  width: 76rpx;
  padding: 8rpx 0;
  border-bottom: 1rpx solid #cfd8cf;
  color: #2d3f32;
  font-size: 24rpx;
  text-align: center;
}

.segment-status {
  width: 74rpx;
  color: #8a938b;
  font-size: 21rpx;
  text-align: right;
}

.category-scroll {
  width: 100%;
  margin-top: 18rpx;
  white-space: nowrap;
}

.category-row {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 28rpx;
}

.category-chip {
  min-height: 54rpx;
  padding: 0 18rpx;
  border: 1rpx solid #d5ded4;
  border-radius: 9rpx;
  color: #667269;
  font-size: 23rpx;
}

.category-active {
  border-color: #1f7a4d;
  background: #e9f4eb;
  color: #1f7a4d;
  font-weight: 700;
}

.note-editor,
.record-editor {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 16rpx;
  padding: 22rpx;
  border: 1rpx solid #e0e6de;
  border-radius: 10rpx;
  background: #ffffff;
}

.note-textarea {
  min-height: 180rpx;
}

.note-list,
.recent-records {
  margin-top: 28rpx;
}

.note-item {
  margin-top: 12rpx;
  padding: 18rpx;
  border-left: 4rpx solid #b5d3bd;
  border-radius: 8rpx;
  background: #f7f9f5;
}

.note-category {
  color: #1f7a4d;
  font-size: 22rpx;
  font-weight: 700;
}

.note-date,
.recent-meta {
  color: #8a938b;
  font-size: 20rpx;
}

.note-title,
.note-content {
  display: block;
}

.note-title {
  margin-top: 10rpx;
  color: #304033;
  font-size: 26rpx;
  font-weight: 700;
}

.note-content {
  margin-top: 6rpx;
  color: #5d685f;
  font-size: 24rpx;
  line-height: 1.55;
}

.note-empty {
  margin-top: 16rpx;
  padding: 34rpx 20rpx;
}

.field {
  margin-top: 0;
}

.rating-row {
  display: flex;
  gap: 14rpx;
  margin-top: 12rpx;
}

.rating {
  display: inline-flex;
  width: 72rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d5ded4;
  border-radius: 8rpx;
  color: #7a857c;
  font-size: 26rpx;
}

.rating-active {
  border-color: #1f7a4d;
  background: #e8f4eb;
  color: #1f7a4d;
  font-weight: 700;
}

.recent-row {
  margin-top: 12rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #e8ece6;
}

.recent-title,
.recent-meta {
  display: block;
}

.recent-title {
  color: #344238;
  font-size: 25rpx;
  font-weight: 700;
}

.recent-meta {
  margin-top: 6rpx;
}

.recent-rating {
  color: #1f7a4d;
  font-size: 25rpx;
  font-weight: 700;
}

.ai-action-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 16rpx;
}

.ai-action {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx;
  border: 1rpx solid #dfe7dc;
  border-radius: 10rpx;
  background: #ffffff;
}

.ai-action-copy {
  min-width: 0;
  flex: 1;
}

.ai-action-title,
.ai-action-hint {
  display: block;
}

.ai-action-title {
  color: #304033;
  font-size: 27rpx;
  font-weight: 700;
}

.ai-action-hint {
  margin-top: 5rpx;
  color: #7b857d;
  font-size: 21rpx;
  line-height: 1.45;
}

.coach-input {
  padding: 2rpx 0;
}

.coach-input .textarea {
  min-height: 120rpx;
}

.ai-result {
  margin-top: 18rpx;
  padding: 20rpx;
  border: 1rpx solid #cfe2d2;
  border-radius: 10rpx;
  background: #f5faf5;
}

.ai-result-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-result-title {
  color: #234b31;
  font-size: 28rpx;
  font-weight: 800;
}

.ai-result-badge {
  padding: 4rpx 10rpx;
  border-radius: 6rpx;
  background: #d9eddd;
  color: #1f7a4d;
  font-size: 18rpx;
  font-weight: 800;
}

.ai-result-summary {
  display: block;
  margin-top: 12rpx;
  color: #506255;
  font-size: 24rpx;
  line-height: 1.55;
}

.ai-list-label {
  display: block;
  margin-top: 18rpx;
  color: #6e7a70;
  font-size: 21rpx;
  font-weight: 700;
}

.ai-list-item {
  display: flex;
  gap: 10rpx;
  align-items: flex-start;
  margin-top: 10rpx;
  color: #3f5144;
  font-size: 23rpx;
  line-height: 1.5;
}

.ai-list-index {
  display: inline-flex;
  width: 30rpx;
  min-width: 30rpx;
  height: 30rpx;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #dceee0;
  color: #1f7a4d;
  font-size: 18rpx;
  font-weight: 700;
}
