<import src="../../templates/load-error.wxml" />
<view class="page scripts-page">
  <template wx:if="{{loadError}}" is="load-error" data="{{message: loadError, hint: loadErrorHint, loading: loading}}" />
  <view class="header">
    <view>
      <text class="title">今天玩什么</text>
      <text class="subtitle">按口味、雷点和游玩经验排序</text>
    </view>
    <button class="btn btn-secondary btn-small" bindtap="goTasteTest">{{tasteCompleted ? '重测口味' : '测口味'}}</button>
  </view>

  <view class="hero-panel">
    <view class="hero-topline"><text class="hero-kicker">JUBEN / PICK</text><text class="hero-count">{{resultCountText}}</text></view>
    <text class="hero-title">{{heroTitle}}</text>
    <text class="hero-desc">{{heroDesc}}</text>
    <view class="hero-metrics">
      <view class="metric"><text class="metric-value">{{highMatchCount}}</text><text class="metric-label">优先候选</text></view>
      <view class="metric"><text class="metric-value">{{savedCount}}</text><text class="metric-label">已收藏</text></view>
      <view class="metric"><text class="metric-value">{{resultCountText}}</text><text class="metric-label">本次候选</text></view>
    </view>
  </view>

  <view wx:if="{{!loggedIn || !tasteCompleted}}" class="taste-banner">
    <view class="taste-copy">
      <text class="taste-title">{{loggedIn ? '还差一步，生成口味画像' : '3 分钟找到更适合你的本'}}</text>
      <text class="taste-desc">{{loggedIn ? '完成 4 道口味题，推荐会结合偏好与雷点排序。' : '未登录也能浏览；登录完成测试后可收藏、跳过并获得个性化理由。'}}</text>
    </view>
    <button class="btn btn-primary banner-btn" bindtap="goTasteTest">开始测试</button>
  </view>

  <view class="search-row">
    <input class="search-input" value="{{filters.q}}" bindinput="onSearchInput" bindconfirm="load" confirm-type="search" placeholder="搜剧本、标签或亮点" />
    <button class="search-btn" bindtap="load">搜索</button>
  </view>

  <view wx:if="{{loggedIn}}" class="occasion-panel">
    <view class="occasion-head"><text class="section-title">这次想怎么选</text><text class="section-hint">硬条件先过滤</text></view>
    <view class="occasion-fields">
      <input class="occasion-input" type="number" value="{{selectionContext.players || ''}}" data-field="players" bindinput="onOccasionInput" placeholder="人数" />
      <input class="occasion-input" type="number" value="{{selectionContext.maxDuration || ''}}" data-field="maxDuration" bindinput="onOccasionInput" placeholder="最长分钟" />
      <picker range="{{difficulties}}" range-key="label" bindchange="onOccasionDifficulty"><view class="occasion-input">{{selectionContext.difficulty || '难度不限'}}</view></picker>
      <button class="btn btn-secondary btn-small" loading="{{selectionSaving}}" bindtap="saveOccasion">应用</button>
    </view>
  </view>

  <view class="collection-row">
    <button wx:for="{{collections}}" wx:key="value" class="filter-chip {{item.active ? 'filter-active' : ''}}" data-field="collection" data-value="{{item.value}}" bindtap="applyFilter">{{item.label}}</button>
  </view>
  <scroll-view scroll-x class="filter-scroll" show-scrollbar="{{false}}">
    <view class="filter-row">
      <button wx:for="{{gameTypes}}" wx:key="value" class="filter-chip {{item.active ? 'filter-active' : ''}}" data-field="gameType" data-value="{{item.value}}" bindtap="applyFilter">{{item.label}}</button>
    </view>
  </scroll-view>
  <scroll-view scroll-x class="filter-scroll difficulty-scroll" show-scrollbar="{{false}}">
    <view class="filter-row">
      <button wx:for="{{difficulties}}" wx:key="value" class="filter-chip compact-chip {{item.active ? 'filter-active' : ''}}" data-field="difficulty" data-value="{{item.value}}" bindtap="applyFilter">{{item.label}}</button>
    </view>
  </scroll-view>

  <view wx:if="{{loading}}" class="loading">正在整理适合你的剧本...</view>
  <view wx:elif="{{!scripts.length && !loadError}}" class="empty">
    <text class="empty-title">没有找到合适结果</text>
    <text class="empty-hint">换个关键词或筛选条件再试试</text>
  </view>
  <view wx:elif="{{scripts.length}}" class="script-list">
    <view class="list-heading"><view><text class="list-title">{{filters.collection === 'saved' ? '我的收藏' : filters.collection === 'dismissed' ? '已跳过的本' : '推荐清单'}}</text></view><text class="list-count">{{resultCountText}}</text></view>
    <view wx:for="{{scripts}}" wx:key="id" class="script-card" data-id="{{item.id}}" bindtap="goDetail">
      <view class="script-head">
        <view class="type-line">
          <text class="script-type">{{item.gameType}}</text>
          <text class="difficulty">{{item.difficulty}}</text>
        </view>
        <view wx:if="{{item.matchScoreText}}" class="match-box">
          <text class="match-score">{{item.matchScoreText}}</text>
          <text class="match-level">{{item.matchLevel}}</text>
        </view>
        <text wx:else class="match-pending">口味待完善</text>
      </view>

      <text class="script-title">{{item.title}}</text>
      <text class="script-meta">{{item.playerText}} · {{item.durationText}} · {{item.difficulty}}</text>

      <view wx:if="{{item.tags.length}}" class="tag-row script-tags">
        <text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text>
      </view>

      <view wx:if="{{item.primaryReason}}" class="reason-line">
        <text class="reason-label">推荐依据</text>
        <text class="reason-text">{{item.primaryReason}}</text>
      </view>

      <view class="signal-grid">
        <view class="signal-block">
          <text class="signal-label">核心亮点</text>
          <text class="signal-text">{{item.highlightText}}</text>
        </view>
        <view class="signal-block warning-block">
          <text class="signal-label warning-label">先看雷点</text>
          <text class="signal-text">{{item.warningText}}</text>
        </view>
      </view>

      <view class="card-actions">
        <button class="text-action" data-id="{{item.id}}" catchtap="toggleCompare">{{item.compareSelected ? '已选对比' : '加入对比'}}</button>
        <button class="text-action" disabled="{{actionPending}}" data-id="{{item.id}}" data-dismissed="{{item.dismissed}}" catchtap="dismiss">{{item.dismissed ? '恢复推荐' : '不感兴趣'}}</button>
        <button class="save-action {{item.saved ? 'save-active' : ''}}" disabled="{{actionPending}}" data-id="{{item.id}}" data-saved="{{item.saved}}" catchtap="toggleSave">{{item.saved ? '已收藏' : '收藏'}}</button>
      </view>
    </view>
    <view wx:if="{{compareIds.length}}" class="compare-bar"><text>已选 {{compareIds.length}} 本</text><button class="text-link" bindtap="clearCompare">清空</button><button class="btn btn-primary btn-small" loading="{{compareLoading}}" bindtap="compareSelected">查看对比</button></view>
    <view wx:if="{{compareItems.length}}" class="compare-panel">
      <view class="compare-head"><text class="section-title">可解释对比</text><button class="text-link" bindtap="clearCompare">关闭</button></view>
      <view wx:for="{{compareItems}}" wx:key="id" class="compare-row"><view class="compare-title"><text>{{item.title}}</text><text>{{item.matchScore === null ? '口味待完善' : item.matchScore + ' 分'}}</text></view><text class="compare-meta">{{item.contentStatus === 'verified' ? '已核验' : '资料待确认'}} · {{item.durationMin}} 分钟 · {{item.minPlayers}}-{{item.maxPlayers}} 人</text><text class="compare-reasons">{{item.conflicts.length ? item.conflicts.join('、') : (item.matchReasons.join('、') || '暂无额外冲突')}}</text></view>
    </view>
    <button wx:if="{{hasMore}}" class="btn btn-secondary btn-full" loading="{{loadingMore}}" disabled="{{loadingMore}}" bindtap="loadMore">加载更多</button>
  </view>
</view>
