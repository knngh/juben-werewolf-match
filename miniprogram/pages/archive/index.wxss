.archive-page {
  padding-top: 22rpx;
}

.toolbar > view {
  flex: 1;
  min-width: 0;
}

.toolbar .btn,
.archive-page .text-link {
  width: auto;
  flex-shrink: 0;
}

.text-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.archive-hero {
  margin-top: 28rpx;
  padding: 28rpx 26rpx;
  border-radius: 12rpx;
  background: #25352a;
  color: #ffffff;
}

.archive-kicker {
  display: block;
  color: #b8d8bf;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
}

.archive-title {
  display: block;
  margin-top: 16rpx;
  font-size: 40rpx;
  font-weight: 800;
}

.archive-desc {
  display: block;
  margin-top: 8rpx;
  color: #c8d8cb;
  font-size: 24rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 18rpx;
}

.stat-card {
  padding: 20rpx 10rpx;
  border: 1rpx solid #dfe7dc;
  border-radius: 10rpx;
  background: #ffffff;
  text-align: center;
}

.stat-value,
.stat-label {
  display: block;
}

.stat-value {
  color: #1f7a4d;
  font-size: 34rpx;
  font-weight: 800;
}

.stat-label {
  margin-top: 6rpx;
  color: #7b8075;
  font-size: 21rpx;
}

.type-section,
.record-section {
  margin-top: 30rpx;
}

.type-list {
  margin-top: 16rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e6de;
  border-radius: 10rpx;
  background: #ffffff;
}

.type-row {
  display: flex;
  gap: 12rpx;
  align-items: center;
  margin-top: 16rpx;
  color: #566359;
  font-size: 24rpx;
}

.type-row:first-child {
  margin-top: 0;
}

.type-bar {
  height: 12rpx;
  flex: 1;
  overflow: hidden;
  border-radius: 6rpx;
  background: #e8eee7;
}

.type-bar view {
  height: 100%;
  border-radius: 6rpx;
  background: #6aab7b;
}

.type-count {
  width: 26rpx;
  color: #1f7a4d;
  text-align: right;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-head .section-title {
  margin-bottom: 0;
}

.text-link {
  color: #1f7a4d;
  font-size: 23rpx;
}

.record-list {
  margin-top: 12rpx;
}

.record-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e6ebe4;
}

.record-main {
  min-width: 0;
  flex: 1;
}

.record-title,
.record-meta,
.record-note {
  display: block;
}

.record-title {
  color: #304033;
  font-size: 28rpx;
  font-weight: 700;
}

.record-meta,
.record-note {
  margin-top: 7rpx;
  color: #7b857d;
  font-size: 22rpx;
  line-height: 1.5;
}

.record-note {
  color: #5e6b61;
  font-size: 24rpx;
}

.record-rating {
  flex: 0 0 auto;
  color: #1f7a4d;
  font-size: 25rpx;
  font-weight: 700;
}

.archive-empty {
  padding: 44rpx 24rpx;
}

.archive-empty-btn {
  margin-top: 20rpx;
  min-height: 64rpx;
  font-size: 24rpx;
}
.item-actions {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.item-actions button {
  margin: 0;
  min-height: 64rpx;
}

.danger-link {
  color: #a33939;
}

.record-title,
.record-meta,
.record-note {
  overflow-wrap: anywhere;
}
